{
  "appId": "com.codecub.desktop",
  "productName": "CodeCub",
  "artifactName": "CodeCub-${version}-${arch}.${ext}",
  "electronDist": ".electron-cache/electron-v39.8.10/electron-v39.8.10-win32-x64.zip",
  "directories": {
    "output": "release"
  },
  "npmRebuild": false,
  "asarUnpack": [
    "node_modules/node-pty/prebuilds/**/*"
  ],
  "files": [
    "dist-electron/**/*",
    "dist-renderer/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/backend/codecub-agent.exe",
      "to": "backend/codecub-agent.exe"
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "CodeCub"
  }
}
