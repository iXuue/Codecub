# Copy this file to .env and fill in the provider you use.
# Real .env files are ignored by Git.

# Provider: openai, deepseek, kimi, minimax, anthropic, or ollama
CODECUB_PROVIDER=openai

# OpenAI-compatible provider
OPENAI_API_BASE=https://your-api.example/v1
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_MODEL=your-model-name

# DeepSeek
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Kimi / Moonshot
MOONSHOT_API_BASE=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=your-moonshot-api-key
MOONSHOT_MODEL=moonshot-v1-8k

# MiniMax
MINIMAX_API_BASE=https://api.minimax.io/v1
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_MODEL=MiniMax-M3

# Anthropic-compatible provider
ANTHROPIC_API_BASE=https://your-anthropic-api.example/v1
ANTHROPIC_API_KEY=your-anthropic-compatible-api-key
ANTHROPIC_MODEL=your-anthropic-model-name

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
